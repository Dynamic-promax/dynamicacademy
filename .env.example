# Copy this file to .env and fill in real values before deploying.
# For local development the defaults in config.py already work fine.

SECRET_KEY=change-this-to-a-long-random-string

# Leave DATABASE_URL unset to use local SQLite (recommended for development).
# For PostgreSQL in production, set an ABSOLUTE connection string, e.g.:
# DATABASE_URL=postgresql://username:password@localhost:5432/dynamic_academy
# DATABASE_URL=

ADMIN_EMAIL=admin@dynamicacademy.ng
ADMIN_PASSWORD=ChangeThisPassword123!
FLASK_DEBUG=1
